{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soline.co.il/blocklib/object.schema.json",
  "title": "Soline Block-Library Object",
  "description": "Authoritative parametric definition of one library object. Validated before any DXF is generated (binding principle 5). Units: millimetres. Coordinate frame: right-handed, origin at the object insertion point (see F_INSERTION_POINTS.md), +X right, +Y away-from-wall/into-room for plan, +Z up.",
  "type": "object",
  "required": ["schemaVersion", "key", "family", "subfamily", "hebrewName", "params", "dims", "views", "insertion", "layers", "metadata"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },

    "key": {
      "type": "string",
      "description": "Globally-unique object key, uppercase, per D_NAMING.md. e.g. KIT-BASE-DR2-0600.",
      "pattern": "^[A-Z]{3,4}(-[A-Z0-9]{2,4})+$"
    },
    "family": { "type": "string", "description": "Top-level family code from B_TAXONOMY.md (e.g. KIT-BASE)." },
    "subfamily": { "type": "string", "description": "Subfamily code from B_TAXONOMY.md (e.g. KIT-BASE-DR)." },
    "domain": { "type": "string", "enum": ["measurement", "interior-kitchen", "outdoor-kitchen"] },

    "hebrewName": { "type": "string", "description": "Human-facing Hebrew name (legend/BOM/app picker)." },
    "englishName": { "type": "string", "description": "Optional engineering label." },

    "params": {
      "type": "object",
      "description": "The parametric inputs that drive geometry. Each param is a typed, ranged value or enum. The resolver reads ONLY these + dims to build views; nothing is hard-coded downstream.",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["number", "integer", "enum", "boolean"] },
          "value": {},
          "unit": { "type": "string", "enum": ["mm", "deg", "count", "ratio", "none"] },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number" },
          "options": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "dims": {
      "type": "object",
      "description": "The object's real bounding envelope in mm (W across, D depth, H height). Nominal/default sizes; may be driven by params.",
      "required": ["w", "d", "h"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "d": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "toeKickH": { "type": "number", "minimum": 0, "description": "plinth/toe-kick height (base cabinets)" },
        "toeKickSetback": { "type": "number", "minimum": 0 },
        "worktopH": { "type": "number", "description": "finished worktop height for a base run (e.g. 900)" },
        "clearance": {
          "type": "object",
          "description": "required install clearances (from manufacturer specs / standards; facts only)",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": false
    },

    "variants": {
      "type": "array",
      "description": "Discrete pre-approved instances of this object (e.g. the 300/450/600/800/900 width family) OR handed/mirrored versions. Each variant overrides params/dims and yields its own block. Keeps the ≤10-per-cycle gate honest: N variants = N blocks.",
      "items": {
        "type": "object",
        "required": ["suffix"],
        "properties": {
          "suffix": { "type": "string", "description": "appended to key/block name, e.g. 0600, L, R" },
          "label": { "type": "string" },
          "overrides": { "type": "object", "description": "param/dims overrides for this variant" }
        },
        "additionalProperties": false
      }
    },

    "views": {
      "type": "object",
      "description": "Which views this object provides and how each is built. A view is a named recipe of primitives in mm (resolver output), OR a declarative build spec the resolver expands. At authoring time, views declares intent + build; the resolver produces the primitive list.",
      "minProperties": 1,
      "properties": {
        "plan":    { "$ref": "#/$defs/view" },
        "front":   { "$ref": "#/$defs/view" },
        "side":    { "$ref": "#/$defs/view" },
        "section": { "$ref": "#/$defs/view" }
      },
      "additionalProperties": false
    },

    "insertion": {
      "type": "object",
      "description": "Insertion-point standard (F_INSERTION_POINTS.md). Per view, the (x,y) in mm within that view's own frame that maps to the block base point, plus the object's default rotation semantics.",
      "required": ["basePoint", "rotationRule"],
      "properties": {
        "basePoint": {
          "type": "object",
          "description": "named anchor + explicit mm offset per view",
          "properties": {
            "anchor": { "type": "string", "enum": ["back-left", "back-center", "back-right", "front-left", "front-center", "center", "wall-line-left"] },
            "plan":    { "$ref": "#/$defs/xy" },
            "front":   { "$ref": "#/$defs/xy" },
            "side":    { "$ref": "#/$defs/xy" },
            "section": { "$ref": "#/$defs/xy" }
          },
          "required": ["anchor"],
          "additionalProperties": false
        },
        "rotationRule": { "type": "string", "enum": ["wall-aligned", "free", "fixed"], "description": "how a placed instance is rotated relative to its host wall" },
        "wallSide": { "type": "string", "enum": ["against-wall", "island", "either"] }
      },
      "additionalProperties": false
    },

    "layers": {
      "type": "object",
      "description": "Layer routing per geometry role (E_LAYERS.md). Values MUST be registered SOL-* layers.",
      "required": ["outline"],
      "properties": {
        "outline":  { "type": "string", "description": "carcass/footprint outline (default SOL-RIHUT)" },
        "door":     { "type": "string", "description": "door/drawer face + swing/open indication" },
        "hardware": { "type": "string", "description": "handles, hinges, mechanism envelope" },
        "fill":     { "type": "string", "description": "hatch/poché if any" },
        "hidden":   { "type": "string", "description": "hidden/dashed edges" },
        "annotation": { "type": "string", "description": "block-internal tags (SOL-TEKST)" }
      },
      "additionalProperties": { "type": "string" }
    },

    "attributes": {
      "type": "array",
      "description": "Block ATTRIB definitions (G_ATTRIBUTES.md). Each becomes an ATTDEF in the block and a schedulable field.",
      "items": {
        "type": "object",
        "required": ["tag", "prompt", "default"],
        "properties": {
          "tag": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "prompt": { "type": "string" },
          "default": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "number", "enum"], "default": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "visible": { "type": "boolean", "default": false },
          "view": { "type": "string", "enum": ["plan", "front", "side", "section"], "default": "plan" },
          "at": { "$ref": "#/$defs/xy" },
          "height": { "type": "number", "description": "text height mm (paper×scale per DXF_PRO_STANDARDS §4)" }
        },
        "additionalProperties": false
      }
    },

    "metadata": {
      "type": "object",
      "required": ["originalGeometry", "sources", "created"],
      "properties": {
        "originalGeometry": { "type": "boolean", "const": true, "description": "attestation: linework authored from scratch (principle 4)" },
        "sources": {
          "type": "array",
          "description": "provenance of every dimension (LICENSES.md). QA fails on unregistered/RED sources.",
          "items": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["cc0", "manufacturer-spec", "standard", "measured", "derived"] },
              "ref": { "type": "string" },
              "note": { "type": "string" },
              "retrieved": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "mepCompanions": { "type": "array", "items": { "type": "string" }, "description": "keys from element_symbols_soline.js this object typically needs" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "created": { "type": "string", "description": "ISO date" },
        "author": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },

  "$defs": {
    "xy": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "description": "One view. 'build' is a declarative recipe the resolver expands into 'primitives'. Authoring may supply either; the resolver always emits primitives, which QA checks.",
      "properties": {
        "provided": { "type": "boolean", "default": true },
        "build": { "type": "object", "description": "declarative parametric recipe (family-specific, resolver-interpreted)" },
        "primitives": {
          "type": "array",
          "description": "explicit primitive list in mm (resolver output or hand-authored override)",
          "items": { "$ref": "#/$defs/primitive" }
        },
        "bbox": { "type": "object", "properties": { "w": {"type":"number"}, "h": {"type":"number"} } }
      },
      "additionalProperties": false
    },
    "primitive": {
      "type": "object",
      "description": "One geometry primitive in mm. Vocabulary is a real-mm superset of element_symbols_soline.js primitives, so the two libraries share a drawing language.",
      "required": ["t"],
      "properties": {
        "t": { "type": "string", "enum": ["line", "rect", "circle", "ellipse", "arc", "poly", "label", "hatch"] },
        "layer": { "type": "string", "description": "override layer for this primitive; else the role default" },
        "x1": {"type":"number"}, "y1": {"type":"number"}, "x2": {"type":"number"}, "y2": {"type":"number"},
        "x0": {"type":"number"}, "y0": {"type":"number"},
        "cx": {"type":"number"}, "cy": {"type":"number"}, "r": {"type":"number"}, "rx": {"type":"number"}, "ry": {"type":"number"},
        "a0": {"type":"number"}, "sweep": {"type":"number"},
        "pts": { "type": "array", "items": { "type": "number" } },
        "closed": { "type": "boolean" },
        "fill": { "type": "boolean" },
        "dash": { "type": "boolean" },
        "wt": { "type": "number", "description": "lineweight multiplier hint (layer weight is default)" },
        "text": { "type": "string" }, "h": { "type": "number" }, "bold": { "type": "boolean" },
        "rad": { "type": "number", "description": "corner radius for rect" }
      },
      "additionalProperties": false
    }
  }
}
