<?xml version="1.0" encoding="utf-8"?>
<Job Created="2026-08-14">
  <ProductVersion>CV 2023</ProductVersion>
  <Unit>mm</Unit>
  <Properties><Job><Information><Job><Name>Room 4x4</Name><Description>4x4m room: door + windows + infrastructure</Description></Job></Information></Job></Properties>
  <Rooms>
    <Room>
      <RoomProperties><Room><General><Name>Room 4x4</Name><Type>Kitchen</Type></General></Room></RoomProperties>
      <Walls>
        <!-- Wall 1: bottom, kitchen wall (4000mm) - sockets over counter + gas + faucet + water/sewage -->
